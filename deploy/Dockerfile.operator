FROM golang:1.26.5-alpine AS builder
WORKDIR /src
COPY go.work go.work.sum ./
COPY apps/operator ./apps/operator
COPY pkg/operator ./pkg/operator
RUN go build -o /bin/operator ./apps/operator/cmd

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=builder /bin/operator /operator
EXPOSE 8080
ENTRYPOINT ["/operator"]