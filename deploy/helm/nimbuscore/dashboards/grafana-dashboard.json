{
  "__inputs": [],
  "__requires": [],
  "title": "NimbusCore Overview",
  "uid": "nimbuscore-overview",
  "version": 2,
  "tags": ["nimbuscore", "kubernetes"],
  "timezone": "browser",
  "panels": [
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(nimbuscore_requests_total{app_kubernetes_io_component=\"api\"}[5m])",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "title": "API Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(nimbuscore_errors_total{app_kubernetes_io_component=\"api\"}[5m])",
          "legendFormat": "errors"
        }
      ]
    },
    {
      "title": "Active Workspaces",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "nimbuscore_active_workspaces{app_kubernetes_io_component=\"api\"}",
          "legendFormat": "Active"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      }
    },
    {
      "title": "Workspace Hours (Billing)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 8 },
      "targets": [
        {
          "expr": "nimbuscore_workspace_hours_total{app_kubernetes_io_component=\"api\"}",
          "legendFormat": "Hours"
        }
      ]
    },
    {
      "title": "Snapshots Created",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 8 },
      "targets": [
        {
          "expr": "nimbuscore_snapshots_total{app_kubernetes_io_component=\"api\"}",
          "legendFormat": "Snapshots"
        }
      ]
    },
    {
      "title": "Workspace Status Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "count by (status) (nimbuscore_workspace_info{app_kubernetes_io_component=\"operator\"})",
          "legendFormat": "{{ status }}"
        }
      ]
    },
    {
      "title": "CPU Usage (per workspace)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(container_cpu_usage_seconds_total{namespace=~\"nimbuscore-.*\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "title": "Memory Usage (per workspace)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"nimbuscore-.*\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "title": "Operator Reconciliation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "rate(controller_runtime_reconcile_total{app_kubernetes_io_component=\"operator\"}[5m])",
          "legendFormat": "Reconciliations"
        },
        {
          "expr": "rate(controller_runtime_reconcile_errors_total{app_kubernetes_io_component=\"operator\"}[5m])",
          "legendFormat": "Errors"
        }
      ]
    },
    {
      "title": "Queue Depth (RabbitMQ)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready{queue=\"nimbuscore.workspace\"}",
          "legendFormat": "Ready"
        },
        {
          "expr": "rabbitmq_queue_messages_unacked{queue=\"nimbuscore.workspace\"}",
          "legendFormat": "Unacked"
        }
      ]
    },
    {
      "title": "Total Snapshots & Prebuilds",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "rate(nimbuscore_snapshots_total[5m])",
          "legendFormat": "Snapshots"
        },
        {
          "expr": "rate(nimbuscore_prebuilds_total[5m])",
          "legendFormat": "Prebuilds"
        }
      ]
    },
    {
      "title": "Billing Cost by Team",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "sum by (team) (nimbuscore_billing_cost_total)",
          "legendFormat": "{{ team }}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "refresh": "30s"
}
