{
  "__inputs": [],
  "__requires": [],
  "title": "NimbusCore Overview",
  "uid": "nimbuscore-overview",
  "version": 1,
  "tags": ["nimbuscore", "kubernetes"],
  "timezone": "browser",
  "panels": [
    {
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total{app_kubernetes_io_component=\"api\"}[5m])",
          "legendFormat": "{{ method }} {{ path }}"
        }
      ]
    },
    {
      "title": "API Request Duration (p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket{app_kubernetes_io_component=\"api\"}[5m]))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "title": "Active Workspaces",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "count(nimbuscore_workspace_info{status=\"running\"})",
          "legendFormat": "Running"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Workspace Status Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 4, "y": 8 },
      "targets": [
        {
          "expr": "count by (status) (nimbuscore_workspace_info)",
          "legendFormat": "{{ status }}"
        }
      ]
    },
    {
      "title": "CPU Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(container_cpu_usage_seconds_total{namespace=~\"nimbuscore-.*\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "title": "Memory Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"nimbuscore-.*\"}) by (pod)",
          "legendFormat": "{{ pod }}"
        }
      ]
    },
    {
      "title": "Operator Reconciliation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "targets": [
        {
          "expr": "rate(controller_runtime_reconcile_total{app_kubernetes_io_component=\"operator\"}[5m])",
          "legendFormat": "Reconciliations"
        },
        {
          "expr": "rate(controller_runtime_reconcile_errors_total{app_kubernetes_io_component=\"operator\"}[5m])",
          "legendFormat": "Errors"
        }
      ]
    },
    {
      "title": "Queue Depth (RabbitMQ)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages_ready{queue=\"nimbuscore.workspace\"}",
          "legendFormat": "Ready"
        },
        {
          "expr": "rabbitmq_queue_messages_unacked{queue=\"nimbuscore.workspace\"}",
          "legendFormat": "Unacked"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "refresh": "30s"
}
